# BackendAPI environment example

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Database
# Choose sqlite (default) or pg
DB_CLIENT=sqlite
# For sqlite you can use a file path or sqlite:// URL
# e.g. ./data/devices.db or sqlite://./data/devices.db
DATABASE_URL=sqlite://./data/devices.db

# For PostgreSQL:
# DB_CLIENT=pg
# DATABASE_URL=postgres://user:password@localhost:5432/devices
