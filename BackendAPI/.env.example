# BackendAPI environment configuration

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
# DB_CLIENT can be 'sqlite' or 'pg'
DB_CLIENT=sqlite
# For sqlite, you can use a file path (e.g., ./data/devices.db) or a URL like sqlite:///absolute/path/devices.db
# For Postgres, use standard connection string, e.g., postgres://user:pass@localhost:5432/devices
DATABASE_URL=./data/devices.db

# CORS
CORS_ORIGIN=http://localhost:3000
