# BackendAPI environment configuration

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
# Origin allowed to access the API (Frontend dev server)
CORS_ORIGIN=http://localhost:3000

# Database
# Choose database client: sqlite (default) or pg
DB_CLIENT=sqlite

# For SQLite: can be a file path or sqlite:// URL
# Examples:
# DATABASE_URL=sqlite://./data/devices.db
# DATABASE_URL=./data/devices.db
DATABASE_URL=sqlite://./data/devices.db

# For PostgreSQL:
# DB_CLIENT=pg
# DATABASE_URL=postgres://appuser:dbuser123@localhost:5432/devices
# Optional SSL toggle for Postgres-based tools that support it
DB_SSL=false
